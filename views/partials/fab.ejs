<!-- Floating Action Buttons -->
<div class="floating-buttons">
    <div class="fab-menu" id="fabMenu">
        <button class="fab-button" onclick="window.open('tel:+919766201734')" title="Call">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                style="color: #4285F4;">
                <path
                    d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z" />
            </svg>
        </button>
        <button class="fab-button fab-whatsapp" onclick="window.open('https://wa.me/7057099100')" title="WhatsApp">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                style="color: #25D366;">
                <path
                    d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z" />
            </svg>
        </button>
        <button class="fab-button fab-calendar" onclick="scrollToSection('#contact')" title="Book Appointment">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <rect x="3" y="4" width="18" height="18" rx="2" ry="2" />
                <line x1="16" y1="2" x2="16" y2="6" />
                <line x1="8" y1="2" x2="8" y2="6" />
                <line x1="3" y1="10" x2="21" y2="10" />
            </svg>
        </button>
    </div>
    <button class="fab-main" id="fabMain" onclick="toggleFab()" aria-label="Open menu">
        <svg class="fab-icon fab-chat" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor"
            stroke-width="2">
            <path
                d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z" />
        </svg>
        <svg class="fab-icon fab-close" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor"
            stroke-width="2">
            <line x1="18" y1="6" x2="6" y2="18" />
            <line x1="6" y1="6" x2="18" y2="18" />
        </svg>
    </button>
</div>

<style>
    .floating-buttons {
        position: fixed;
        bottom: 24px;
        right: 24px;
        z-index: 999;
    }

    .fab-main {
        background: var(--dental-blue, #007bff);
        color: #fff;
        border: none;
        border-radius: 50%;
        width: 56px;
        height: 56px;
        box-shadow: 0 4px 16px rgba(0, 0, 0, 0.15);
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        position: relative;
        transition: background 0.2s;
    }

    .fab-main .fab-icon {
        position: absolute;
        left: 50%;
        top: 50%;
        transform: translate(-50%, -50%);
        transition: opacity 0.2s;
    }

    .fab-main .fab-chat {
        opacity: 1;
    }

    .fab-main.active .fab-chat {
        opacity: 0;
    }

    .fab-main .fab-close {
        opacity: 0;
    }

    .fab-main.active .fab-close {
        opacity: 1;
    }

    .fab-menu {
        display: flex;
        flex-direction: column;
        align-items: flex-end;
        margin-bottom: 12px;
        opacity: 0;
        pointer-events: none;
        transition: opacity 0.2s;
    }

    .fab-menu.active {
        opacity: 1;
        pointer-events: auto;
    }

    .fab-button {
        background: #fff;
        border: none;
        border-radius: 50%;
        width: 48px;
        height: 48px;
        margin-bottom: 12px;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.10);
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        transition: background 0.2s;
        opacity: 0;
        pointer-events: none;
    }

    .fab-menu.active .fab-button {
        opacity: 1;
        pointer-events: auto;
    }

    .fab-button:hover {
        background: var(--dental-blue, #007bff);
        color: #fff;
    }

    @media (max-width: 600px) {
        .floating-buttons {
            bottom: 16px;
            right: 16px;
        }

        .fab-main {
            width: 48px;
            height: 48px;
        }

        .fab-button {
            width: 40px;
            height: 40px;
        }
    }
</style>

<script>
    function toggleFab() {
        var fabMain = document.getElementById('fabMain');
        var fabMenu = document.getElementById('fabMenu');
        fabMain.classList.toggle('active');
        fabMenu.classList.toggle('active');
    }
</script>
