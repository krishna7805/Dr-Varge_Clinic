<!-- Header -->
<header id="header" class="header">
    <div class="container">
        <div class="header-content">
            <!-- Logo -->
            <a href="/" style="text-decoration: none;">
                <div class="logo">
                    <div class="logo-icon">
                        <img src="/Img/Logo.png" style="height: 40px; width: 40px;">
                    </div>
                    <div class="logo-text">
                        <h1>Dr. Virangi Varge</h1>
                        <p>MDS Orthodontics</p>
                    </div>
                </div>
            </a>

            <!-- Desktop Navigation -->
            <nav class="desktop-nav">
                <a href="<%= currentPage === 'home' ? '#home' : '/#home' %>" class="nav-link">Home</a>
                <a href="<%= currentPage === 'home' ? '#about' : '/#about' %>" class="nav-link">About</a>
                <a href="<%= currentPage === 'home' ? '#services' : '/#services' %>" class="nav-link">Services</a>
                <a href="<%= currentPage === 'home' ? '#gallery' : '/#gallery' %>" class="nav-link">Gallery</a>
                <a href="<%= currentPage === 'home' ? '#testimonials' : '/#testimonials' %>" class="nav-link">Testimonials</a>
                <a href="<%= currentPage === 'home' ? '#contact' : '/#contact' %>" class="nav-link">Contact</a>
            </nav>

            <!-- Desktop CTA -->
            <div class="desktop-cta">
                <a href="tel:+917057099100" class="phone-link">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                        stroke-width="2">
                        <path
                            d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z" />
                    </svg>
                    +91 7057 099 100
                </a>
                <button class="btn btn-primary" onclick="scrollToSection('#contact')">Book Appointment</button>
            </div>

            <!-- Hamburger Menu Button -->
            <button class="mobile-menu-btn" id="mobileMenuBtn" aria-label="Open menu">
                <span></span>
                <span></span>
                <span></span>
            </button>
        </div>

        <!-- Mobile Menu -->
        <div class="mobile-menu" id="mobileMenu">
            <nav class="mobile-nav">
                <a href="<%= currentPage === 'home' ? '#home' : '/#home' %>" class="nav-link">Home</a>
                <a href="<%= currentPage === 'home' ? '#about' : '/#about' %>" class="nav-link">About</a>
                <a href="<%= currentPage === 'home' ? '#services' : '/#services' %>" class="nav-link">Services</a>
                <a href="<%= currentPage === 'home' ? '#gallery' : '/#gallery' %>" class="nav-link">Gallery</a>
                <a href="<%= currentPage === 'home' ? '#testimonials' : '/#testimonials' %>" class="nav-link">Testimonials</a>
                <a href="<%= currentPage === 'home' ? '#contact' : '/#contact' %>" class="nav-link">Contact</a>
                <div class="mobile-cta">
                    <a href="tel:+917057099100" class="phone-link">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                            stroke-width="2">
                            <path
                                d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z" />
                        </svg>
                        +91 7057 099 100
                    </a>
                    <button class="btn btn-primary" onclick="scrollToSection('#contact')">Book Appointment</button>
                </div>
            </nav>
        </div>
    </div>
</header>

<style>
    /* Hamburger styles */
    .mobile-menu-btn {
        display: none;
        flex-direction: column;
        gap: 5px;
        background: none;
        border: none;
        cursor: pointer;
        padding: 8px;
    }

    .mobile-menu-btn span {
        display: block;
        width: 28px;
        height: 4px;
        background: var(--dental-blue, #007bff);
        border-radius: 2px;
    }

    .mobile-menu {
        display: none;
        position: absolute;
        top: 70px;
        left: 0;
        width: 100%;
        background: #fff;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.04);
        z-index: 100;
    }

    .mobile-menu.active {
        display: block;
        padding: 1rem;
    }

    @media (max-width: 1024px) {
        .desktop-nav,
        .desktop-cta {
            display: none;
        }

        .mobile-menu-btn {
            display: flex;
        }
    }

    @media (min-width: 1024px) {
        .mobile-menu {
            display: none !important;
        }
    }
</style>

<script>
    document.getElementById('mobileMenuBtn').addEventListener('click', function () {
        document.getElementById('mobileMenu').classList.toggle('active');
    });
</script>
